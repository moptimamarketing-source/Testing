# Meta Marketing API
# 1. Salin fail ni: cp .env.example .env
# 2. Isi nilai di bawah SENDIRI (buka dengan Notepad/TextEdit/VS Code)
# 3. JANGAN tampal token dalam chat AI. JANGAN commit fail .env.

# Token dari System User (Bab 5 ebook). Expiry: Never.
META_ACCESS_TOKEN=

# ID akaun iklan - MESTI ada 'act_' di depan.
# Ambil dari URL Ads Manager, nombor selepas act=
META_AD_ACCOUNT_ID=act_

# ID Facebook Page yang iklan "bercakap" sebagai (pilihan, untuk cipta iklan)
META_PAGE_ID=

# Versi Graph API
META_API_VERSION=v23.0

# --- Fasa seterusnya (biar kosong dulu) ---
# GOOGLE_SHEET_ID=
# AIRTABLE_TOKEN=
# AIRTABLE_BASE_ID=
